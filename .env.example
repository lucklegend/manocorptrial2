# All optional. With none set, vidgen still produces a video using free/offline fallbacks.

# Script writing (first one that is set wins; Ollama on localhost is also tried, no key)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=          # free tier at aistudio.google.com

# Real stock footage + photos (both free accounts)
PEXELS_API_KEY=          # pexels.com/api
PIXABAY_API_KEY=         # pixabay.com/api/docs

# Optional tweaks
# VIDGEN_VOICE=en-US-AndrewMultilingualNeural   # any edge-tts voice: `edge-tts --list-voices`
# VIDGEN_TTS_RATE=+8%
# VIDGEN_ANTHROPIC_MODEL=claude-sonnet-5-5
